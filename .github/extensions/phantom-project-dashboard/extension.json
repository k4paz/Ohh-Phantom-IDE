{
  "version": 1,
  "initialization": "module",
  "canvases": [{
    "id": "phantom-project-dashboard",
    "displayName": "PHANTOM Project Dashboard",
    "description": "Shows project status and workspace notes for PHANTOM.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspaceRoot": { "type": "string", "description": "Workspace directory for this dashboard." }
      },
      "additionalProperties": false
    },
    "actions": [
      {
        "name": "refresh",
        "description": "Refresh repository status."
      },
      {
        "name": "add_note",
        "description": "Add a workspace note.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": { "type": "string", "minLength": 1, "maxLength": 500 }
          },
          "required": ["text"],
          "additionalProperties": false
        }
      }
    ]
  }]
}
